# 本目錄自身的說明文件,不該被部署到 home。
README.md

# 依 profile 排除不需要的設定檔。
# 非 workstation(測試用的 vm / container)不部署臃腫的編輯器設定。
{{ if ne .profile "workstation" }}
.config/nvim
{{ end }}

# gitconfig 僅部署到 vm:container 無 delta(pager=delta 會報錯),
# workstation 的 ~/.gitconfig 由 stow 符號連結擁有,chezmoi 不應覆寫。
{{ if ne .profile "vm" }}
.gitconfig
{{ end }}

# tmux 設定僅部署到 vm:workstation 的 ~/.config/tmux 由 stow 擁有,container 精簡不需要。
{{ if ne .profile "vm" }}
.config/tmux
{{ end }}
