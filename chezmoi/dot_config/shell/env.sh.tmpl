# 由 chezmoi 管理 — profile: {{ .profile }} / os: {{ .chezmoi.os }}
# 內容:PATH + 可攜別名 + history(bash/zsh 共用的 POSIX 子集)。
# 在你的 shell rc 中 source 本檔:
#   [ -f ~/.config/shell/env.sh ] && . ~/.config/shell/env.sh

export DOTFILES_PROFILE="{{ .profile }}"

{{ if eq .chezmoi.os "linux" -}}
# Debian 的 fd / bat 執行檔名為 fdfind / batcat,安裝腳本會在
# ~/.local/bin 建立相容 symlink(mise 本體也裝在此),需確保它在 PATH 中。
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}
{{ if ne .profile "container" -}}
# mise 安裝的工具透過 shims 暴露(shell 無關,免 mise activate)。
export PATH="$HOME/.local/share/mise/shims:$PATH"
{{ end -}}

# ---- 別名(工具存在才設,container 無 mise 工具時自動退回原生指令) ----
command -v eza >/dev/null 2>&1 && {
    alias ls='eza --icons=always'
    alias lt='eza --tree --level=2 --long --icons --git'
}
alias ll='ls -lhg'
alias clr='clear'
alias grep='grep --color=auto'
command -v rg  >/dev/null 2>&1 && alias rg='rg --pretty'
command -v bat >/dev/null 2>&1 && {
    alias cat='bat --style plain'
    alias catn='bat'
}

# ---- history(分 shell;另一個 shell 走不到的分支只會被解析、不會執行) ----
HISTSIZE=10000
if [ -n "$ZSH_VERSION" ]; then
    SAVEHIST=10000
    HISTFILE="$HOME/.zsh_history"
    setopt HIST_IGNORE_DUPS
elif [ -n "$BASH_VERSION" ]; then
    HISTFILESIZE=10000
    HISTCONTROL=ignoredups
fi
