# 由 chezmoi 管理 — profile: {{ .profile }} / os: {{ .chezmoi.os }}
# 內容:PATH + 可攜別名(含 git 縮寫)+ history + zoxide(bash/zsh 共用的 POSIX 子集)。
# 在你的 shell rc 中 source 本檔:
#   [ -f ~/.config/shell/env.sh ] && . ~/.config/shell/env.sh

export DOTFILES_PROFILE="{{ .profile }}"

{{ if eq .chezmoi.os "linux" -}}
# Debian 的 fd / bat 執行檔名為 fdfind / batcat,安裝腳本會在
# ~/.local/bin 建立相容 symlink(mise 本體也裝在此),需確保它在 PATH 中。
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}
{{ if ne .profile "container" -}}
# mise 安裝的工具透過 shims 暴露(shell 無關,免 mise activate)。
export PATH="$HOME/.local/share/mise/shims:$PATH"
{{ end -}}

# ---- 別名(工具存在才設,container 無 mise 工具時自動退回原生指令) ----
command -v eza >/dev/null 2>&1 && {
    alias ls='eza --icons=always'
    alias lt='eza --tree --level=2 --long --icons --git'
}
alias ll='ls -lhg'
alias clr='clear'
alias grep='grep --color=auto'
command -v rg  >/dev/null 2>&1 && alias rg='rg --pretty'
command -v bat >/dev/null 2>&1 && {
    alias cat='bat --style plain'
    alias catn='bat'
}

# ---- git 縮寫(精選,跨 shell;對應 mac OMZ git 外掛常用子集) ----
# g=git 即可搭配 .gitconfig 的 alias:g lg / g st / g co …
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gst='git status'
alias gss='git status --short'
alias gb='git branch'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gc='git commit -v'
alias gcmsg='git commit -m'      # 註:OMZ 的 gcm 是「checkout 主分支」,易混淆,故用 gcmsg
alias gd='git diff'
alias gds='git diff --staged'
alias gp='git push'
alias gl='git pull'
alias gf='git fetch'
alias glog='git log --oneline --decorate --graph'

# ---- history(分 shell;另一個 shell 走不到的分支只會被解析、不會執行) ----
HISTSIZE=10000
if [ -n "$ZSH_VERSION" ]; then
    SAVEHIST=10000
    HISTFILE="$HOME/.zsh_history"
    setopt HIST_IGNORE_DUPS
elif [ -n "$BASH_VERSION" ]; then
    HISTFILESIZE=10000
    HISTCONTROL=ignoredups
fi

# ---- zoxide:讓 cd 具備 frecency 跳轉(z 行為);zoxide 不在(container)則跳過 ----
# --cmd cd 直接以 zoxide 取代 cd:cd <部分路徑> 會跳到最常去的相符目錄,cd 無參數仍回 $HOME。
# zoxide 官方建議初始化放在 rc 末段,故置於本檔最後。
if command -v zoxide >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(zoxide init zsh --cmd cd)"
    elif [ -n "$BASH_VERSION" ]; then
        eval "$(zoxide init bash --cmd cd)"
    fi
fi
