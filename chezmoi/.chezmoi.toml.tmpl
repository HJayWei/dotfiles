{{- /* chezmoi init 時詢問一次,把結果存進 config,之後所有 template 都讀 .profile */ -}}
{{- /* WSL 的 kernel osrelease 含 "microsoft",以此預選 wsl;其餘預設 vm。
       .chezmoi.kernel 在 mac 為空 map,先 index 再 default 以免 nil 進 lower。 */ -}}
{{- $defaultProfile := "vm" -}}
{{- if index .chezmoi.kernel "osrelease" | default "" | lower | contains "microsoft" -}}
{{-   $defaultProfile = "wsl" -}}
{{- end -}}
{{- /* profile 刻意用 promptString 而非 promptStringOnce:Once 會無條件沿用既有 config 的值,
       連 bootstrap 的 --promptString 都蓋不過(曾導致同一台機器 vm → wsl 切換失敗)。
       改為「既有值當預設」:重跑 init 不會意外改掉 profile,但選單選了就一定生效。 */ -}}
{{- if hasKey . "profile" -}}
{{-   $defaultProfile = .profile -}}
{{- end -}}
{{- $profile := promptString "環境 profile (container/vm/wsl/workstation)" $defaultProfile -}}

{{- /* git 身分僅 vm / wsl 用得到(gitconfig 只部署到這兩者)。留空則 dot_gitconfig 不寫該欄位;
       其餘 profile 仍寫空字串進 data,避免 template 缺 key 報錯。 */ -}}
{{- $gitName := "" -}}
{{- $gitEmail := "" -}}
{{- if or (eq $profile "vm") (eq $profile "wsl") -}}
{{-   $gitName = promptStringOnce . "git_name" "Git user.name(留空則不寫入)" "" -}}
{{-   $gitEmail = promptStringOnce . "git_email" "Git user.email(留空則不寫入)" "" -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    git_name = {{ $gitName | quote }}
    git_email = {{ $gitEmail | quote }}
