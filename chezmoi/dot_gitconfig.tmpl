# 由 chezmoi 管理 — profile: {{ .profile }}(可攜核心;機制/主題層留給 workstation stow)
{{ if eq .profile "wsl" -}}
[include]
    path = ~/.config/delta/themes.gitconfig

{{ end -}}
{{ if or .git_name .git_email -}}
[user]
{{- if .git_name }}
    name = {{ .git_name }}
{{- end }}
{{- if .git_email }}
    email = {{ .git_email }}
{{- end }}

{{ end -}}
[color]
    ui = true

[init]
    defaultBranch = main

[core]
    pager = delta
{{- if eq .profile "wsl" }}
    editor = nvim
{{- end }}

[interactive]
    diffFilter = delta --color-only

[delta]
{{- if eq .profile "wsl" }}
    features = chameleon
{{- end }}
    navigate = true
    side-by-side = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    co = commit
    st = status
    ch = checkout
    br = branch
    lg = log --color --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    lga = log --color --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --all
    lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim blue)<%an>%C(reset)'
    lga2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim blue)<%an>%C(reset)' --all
    lgst = log --color --graph --stat
    dtree = diff-tree -r --no-commit-id --name-status --text --diff-filter=ACDMRT
