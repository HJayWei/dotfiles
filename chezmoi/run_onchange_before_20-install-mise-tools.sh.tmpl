{{ if ne .profile "container" -}}
#!/bin/sh
# 安裝 mise,並用它跨平台安裝 apt 沒有(或過舊)的現代 CLI 與 runtime。
# container profile 用完即丟,預設略過:整段 template 會渲染為空,chezmoi 即不執行。
set -eu

echo "==> [mise] 安裝 mise 與 runtime 工具"

if ! command -v mise >/dev/null 2>&1; then
{{ if eq .chezmoi.os "darwin" -}}
    brew install mise
{{ else -}}
    curl -fsSL https://mise.run | sh
{{ end -}}
fi

export PATH="$HOME/.local/bin:$PATH"
mise use -g {{ range .packages.mise }}{{ . }} {{ end }}
{{ end -}}
